# Copy to .env and fill in. Never commit .env.

# --- Providers ----------------------------------------------------------
# "mock" runs the whole pipeline without paid API calls (fake script + tone audio).
LLM_PROVIDER=anthropic          # anthropic | mock
TTS_PROVIDER=elevenlabs         # elevenlabs | mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Optional ---------------------------------------------------------------
# DATA_DIR=./data               # SQLite DB, generated audio, TTS cache
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg   # default: bundled ffmpeg-static
